<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox minHeight="620.0" minWidth="1080.0" prefHeight="700.0" prefWidth="1180.0" spacing="18.0"
      styleClass="ai-scan-view" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AiInvoiceScanController">
   <children>
      <BorderPane>
         <left>
            <VBox spacing="4.0" BorderPane.alignment="CENTER_LEFT">
               <Label styleClass="ai-scan-eyebrow" text="DOCUMENT AI" />
               <Label styleClass="ai-scan-title" text="Document review queue" />
               <Label styleClass="ai-scan-subtitle" text="Review invoices and statements discovered in this store's watched Google Drive folders." />
            </VBox>
         </left>
      </BorderPane>

      <HBox fx:id="scanSourceBar" alignment="CENTER_LEFT" spacing="12.0" styleClass="scan-source-bar">
         <Label styleClass="scan-source-description" text="Source folders and automatic scanning are managed from Settings." wrapText="true" />
         <Button fx:id="scanButton" onAction="#scanDocuments" styleClass="primary-scan-button" text="Scan now" />
         <Button fx:id="refreshQueueButton" accessibleText="Refresh document review queue" contentDisplay="GRAPHIC_ONLY" onAction="#refreshQueue" styleClass="refresh-icon-button">
            <graphic>
               <SVGPath content="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z" fill="#4b4860" scaleX="1.15" scaleY="1.15" />
            </graphic>
            <tooltip>
               <Tooltip text="Refresh document review queue" />
            </tooltip>
         </Button>
         <ProgressIndicator fx:id="scanProgress" managed="true" maxHeight="28.0" maxWidth="28.0" prefHeight="28.0" prefWidth="28.0" progress="-1.0" visible="false" />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="reviewAllButton" disable="true" onAction="#reviewAll" styleClass="primary-scan-button" text="Review all invoices">
            <tooltip><Tooltip text="Review all ready invoice batches together, then save them in one go. Review statements individually to compare their printed and extracted totals." /></tooltip>
         </Button>
      </HBox>

      <BorderPane fx:id="scanSummaryBar">
         <left>
            <Label fx:id="summaryLabel" styleClass="scan-summary" text="Loading the store review queue…" BorderPane.alignment="CENTER_LEFT" />
         </left>
         <right>
            <HBox fx:id="reviewBatchControls" alignment="CENTER_RIGHT" managed="false" spacing="10.0" visible="false" BorderPane.alignment="CENTER_RIGHT">
               <CheckBox fx:id="showMatchedCheck" selected="false" text="Show accepted rows" />
               <Label fx:id="acceptanceSummaryLabel" styleClass="scan-summary" text="" />
               <ProgressIndicator fx:id="saveAcceptedProgress" managed="false" maxHeight="24.0" maxWidth="24.0" prefHeight="24.0" prefWidth="24.0" progress="-1.0" visible="false" />
               <Button fx:id="saveAcceptedButton" disable="true" managed="false" onAction="#saveAccepted" styleClass="primary-scan-button" text="Save accepted documents" visible="false" />
            </HBox>
         </right>
      </BorderPane>

      <ProgressBar fx:id="reviewLoadProgress" accessibleText="Review loading progress" managed="false" maxWidth="1.7976931348623157E308" progress="-1.0" styleClass="review-load-progress" visible="false" />

      <HBox fx:id="statementTotalsBar" managed="false" spacing="10.0" styleClass="statement-totals-bar" visible="false">
         <VBox maxWidth="1.7976931348623157E308" spacing="3.0" styleClass="statement-total-card" HBox.hgrow="ALWAYS">
            <Label styleClass="statement-total-title" text="PRINTED STATEMENT AMOUNT" />
            <Label fx:id="expectedStatementAmountLabel" styleClass="statement-total-value" text="Not found" />
            <Label fx:id="expectedStatementConfidenceLabel" styleClass="statement-total-detail" text="Printed total confidence unavailable" />
         </VBox>
         <VBox maxWidth="1.7976931348623157E308" spacing="3.0" styleClass="statement-total-card" HBox.hgrow="ALWAYS">
            <Label styleClass="statement-total-title" text="EXTRACTED INVOICES + CREDITS" />
            <Label fx:id="extractedStatementTotalLabel" styleClass="statement-total-value" text="\$0.00" />
            <Label styleClass="statement-total-detail" text="Credits are included as negative values" />
         </VBox>
         <VBox maxWidth="1.7976931348623157E308" spacing="3.0" styleClass="statement-total-card" HBox.hgrow="ALWAYS">
            <Label styleClass="statement-total-title" text="STATEMENT VARIANCE" />
            <Label fx:id="statementVarianceLabel" styleClass="statement-total-value statement-total-unavailable" text="Unavailable" />
            <Label styleClass="statement-total-detail" text="Extracted total minus printed amount" />
         </VBox>
      </HBox>

      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <VBox fx:id="queueView" spacing="8.0">
               <Label styleClass="preview-section-title" text="Waiting for review" />
               <TableView fx:id="queueTable" VBox.vgrow="ALWAYS" />
               <Label styleClass="preview-hint" text="Queued means waiting for the worker; Scanning means Gemini is processing; Failed rows show a reason and can be retried. This table refreshes every 5 seconds." />
            </VBox>

            <VBox fx:id="resultsView" managed="false" spacing="12.0" visible="false">
               <HBox alignment="CENTER_LEFT" spacing="14.0">
                  <Button fx:id="resultsBackButton" onAction="#backToQueue" styleClass="secondary-scan-button, review-toolbar-button" text="‹ Back to queue" />
                  <Label styleClass="results-section-title" text="Reconciliation results" />
               </HBox>
               <Label fx:id="combinedReviewHint" managed="false" styleClass="bulk-editor-help" visible="false" wrapText="true" />
               <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="selection-toolbar">
                  <Label fx:id="selectedRowsLabel" minWidth="125.0" styleClass="selection-count" text="No rows selected" />
                  <Button fx:id="selectAllResultsButton" onAction="#selectAllResults" styleClass="selection-link-button" text="Select all" />
                  <Button fx:id="clearResultSelectionButton" onAction="#clearResultSelection" styleClass="selection-link-button" text="Clear selection" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="editSelectedButton" disable="true" onAction="#openBulkEdit" styleClass="secondary-scan-button, review-toolbar-button" text="Edit selected">
                     <graphic><SVGPath content="M12 2L14 4L6 12L2 14L4 10Z M10 4L12 6" fill="TRANSPARENT" stroke="#40516e" strokeWidth="1.5" /></graphic>
                  </Button>
                  <Button fx:id="acceptSelectedButton" disable="true" onAction="#acceptSelected" styleClass="primary-scan-button, review-toolbar-button" text="Accept selected">
                     <graphic><SVGPath content="M2 8L6 12L14 3" fill="TRANSPARENT" stroke="WHITE" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="2.0" /></graphic>
                     <tooltip><Tooltip text="Accept the selected values for review. Use Save accepted documents when all rows are ready." /></tooltip>
                  </Button>
               </HBox>
               <VBox fx:id="bulkEditPanel" managed="false" spacing="12.0" styleClass="bulk-editor" visible="false">
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <Label styleClass="bulk-editor-title" text="Edit selected rows" />
                     <Label fx:id="bulkEditSelectionLabel" maxWidth="1.7976931348623157E308" styleClass="bulk-editor-help" text="Select rows in the table to edit them together." wrapText="true" HBox.hgrow="ALWAYS" />
                     <Button fx:id="closeBulkEditButton" onAction="#closeBulkEdit" styleClass="selection-link-button" text="Close editor" />
                  </HBox>
                  <HBox alignment="TOP_LEFT" spacing="20.0">
                     <VBox minWidth="190.0" prefWidth="210.0" spacing="8.0">
                        <Label labelFor="$bulkEditFieldChoice" minHeight="24.0" styleClass="bulk-field-label" text="Field to change" />
                        <ChoiceBox fx:id="bulkEditFieldChoice" maxWidth="1.7976931348623157E308" />
                     </VBox>
                     <VBox maxWidth="580.0" minWidth="330.0" prefWidth="480.0" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" minHeight="24.0" spacing="12.0">
                           <Label fx:id="bulkEditValueLabel" maxWidth="1.7976931348623157E308" styleClass="bulk-field-label" text="Supplier" HBox.hgrow="ALWAYS" />
                           <CheckBox fx:id="bulkCustomSupplierCheck" text="New supplier" />
                        </HBox>
                        <ComboBox fx:id="bulkSupplierChoice" maxWidth="1.7976931348623157E308" promptText="Choose an existing supplier" />
                        <TextField fx:id="bulkCustomSupplierNameField" managed="false" promptText="Enter supplier name" visible="false" />
                        <DatePicker fx:id="bulkDatePicker" managed="false" maxWidth="1.7976931348623157E308" promptText="Choose a date" visible="false" />
                        <TextField fx:id="bulkNotesField" managed="false" maxWidth="1.7976931348623157E308" promptText="Enter notes, or leave blank to clear" visible="false" />
                        <Label fx:id="bulkEditHelpLabel" maxWidth="580.0" styleClass="bulk-editor-help" text="Choose an existing supplier, or enter a new name." wrapText="true" />
                     </VBox>
                     <VBox spacing="8.0">
                        <Region minHeight="24.0" prefHeight="24.0" maxHeight="24.0" />
                        <Button fx:id="applyBulkEditButton" minWidth="175.0" onAction="#applyBulkEdit" styleClass="primary-scan-button, review-toolbar-button" text="Apply to selected">
                           <tooltip><Tooltip text="Update the selected rows. Accept your edits, then save accepted documents when ready." /></tooltip>
                        </Button>
                     </VBox>
                  </HBox>
               </VBox>
               <Label fx:id="bulkReviewMessageLabel" managed="false" maxWidth="1.7976931348623157E308" styleClass="bulk-review-feedback" visible="false" wrapText="true" />
               <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS" />
               <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="scan-legend">
                  <Region styleClass="legend-good" />
                  <Label text="Matched / accepted / saved" />
                  <Region styleClass="legend-review" />
                  <Label text="Within 20¢ tolerance" />
                  <Region styleClass="legend-attention" />
                  <Label text="Needs attention" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="Ctrl/Cmd-click or Shift-click to select rows. Double-click to review." />
               </HBox>
            </VBox>

            <BorderPane fx:id="reviewView" managed="false" styleClass="review-workspace" visible="false">
               <center>
                  <VBox minWidth="560.0" spacing="8.0" styleClass="pdf-preview-panel">
                     <BorderPane>
                        <left>
                           <VBox spacing="2.0" BorderPane.alignment="CENTER_LEFT">
                              <Label styleClass="preview-section-title" text="PDF evidence" />
                              <Label fx:id="previewDocumentLabel" maxWidth="620.0" styleClass="preview-document" text="Select a result row" textOverrun="ELLIPSIS" />
                           </VBox>
                        </left>
                        <right>
                           <HBox alignment="CENTER_RIGHT" spacing="5.0" BorderPane.alignment="CENTER_RIGHT">
                              <Button fx:id="toggleStatementPdfButton" managed="false" onAction="#toggleStatementPdf" styleClass="secondary-scan-button" text="Show invoice PDF" visible="false">
                                 <tooltip><Tooltip text="Switch between the statement and its matched invoice or credit PDF." /></tooltip>
                              </Button>
                              <Button onAction="#zoomPreviewOut" styleClass="preview-control" text="−" />
                              <Button onAction="#zoomPreviewIn" styleClass="preview-control" text="+" />
                              <Button fx:id="rotatePreviewButton" accessibleText="Rotate PDF preview clockwise" disable="true" onAction="#rotatePreview" styleClass="preview-control preview-rotate-control" text="↻">
                                 <tooltip>
                                    <Tooltip text="Rotate preview 90° clockwise" />
                                 </tooltip>
                              </Button>
                           </HBox>
                        </right>
                     </BorderPane>
                     <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="evidence-legend">
                        <Region styleClass="evidence-key evidence-supplier" />
                        <Label text="Supplier" />
                        <Region styleClass="evidence-key evidence-reference" />
                        <Label text="Reference" />
                        <Region styleClass="evidence-key evidence-date" />
                        <Label text="Date" />
                        <Region styleClass="evidence-key evidence-amount" />
                        <Label text="Amount" />
                     </HBox>
                     <ScrollPane fx:id="pdfScrollPane" fitToHeight="false" fitToWidth="false" pannable="true" styleClass="pdf-scroll" VBox.vgrow="ALWAYS">
                        <content>
                           <StackPane fx:id="pdfPageStack" alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="pdf-page">
                              <children>
                                 <ImageView fx:id="pdfPreviewImage" preserveRatio="false" smooth="true" StackPane.alignment="TOP_LEFT" />
                                 <Pane fx:id="pdfOverlayPane" mouseTransparent="true" pickOnBounds="false" StackPane.alignment="TOP_LEFT" />
                              </children>
                           </StackPane>
                        </content>
                     </ScrollPane>
                     <BorderPane>
                        <left>
                           <Button fx:id="previousPageButton" disable="true" onAction="#previousPreviewPage" styleClass="preview-control" text="‹ Previous" BorderPane.alignment="CENTER_LEFT" />
                        </left>
                        <center>
                           <Label fx:id="previewPageLabel" styleClass="preview-page-label" text="No PDF loaded" BorderPane.alignment="CENTER" />
                        </center>
                        <right>
                           <Button fx:id="nextPageButton" disable="true" onAction="#nextPreviewPage" styleClass="preview-control" text="Next ›" BorderPane.alignment="CENTER_RIGHT" />
                        </right>
                     </BorderPane>
                     <Label fx:id="previewHintLabel" styleClass="preview-hint" text="Review the highlighted source values before accepting." wrapText="true" />
                  </VBox>
               </center>
               <right>
                  <BorderPane minWidth="350.0" prefWidth="370.0" styleClass="review-editor">
                     <center>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="review-editor-scroll">
                           <content>
                              <VBox spacing="10.0">
                                 <Label fx:id="reviewTitleLabel" styleClass="review-editor-title" text="Review invoice" />
                                 <Label fx:id="reviewHelpLabel" styleClass="review-editor-help" text="Correct the scanned values, then accept this document for the final save." wrapText="true" />
                                 <Label fx:id="reviewErrorLabel" managed="false" styleClass="review-editor-error" visible="false" wrapText="true" />
                                 <Label fx:id="reviewClassificationWarningLabel" managed="false" styleClass="scan-warning" visible="false" wrapText="true" />
                                 <Label styleClass="review-field-label" text="Supplier" />
                                 <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <ComboBox fx:id="reviewSupplierChoice" maxWidth="1.7976931348623157E308" promptText="Select an existing supplier" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="customSupplierButton" accessibleText="Use a custom supplier name" contentDisplay="GRAPHIC_ONLY" onAction="#toggleCustomSupplier" styleClass="secondary-scan-button custom-supplier-button">
                                       <graphic>
                                          <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z M20.71 7.04c.39-.39.39-1.03 0-1.42l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.82z" fill="#4b4860" scaleX="0.72" scaleY="0.72" />
                                       </graphic>
                                       <tooltip>
                                          <Tooltip text="Use a custom supplier name" />
                                       </tooltip>
                                    </Button>
                                 </HBox>
                                 <TextField fx:id="customSupplierNameField" managed="false" promptText="Custom supplier name" visible="false" />
                                 <Label fx:id="customSupplierHelpLabel" managed="false" styleClass="review-editor-help" text="This name will be added to this store's supplier list when the document is saved." visible="false" wrapText="true" />
                                 <Label styleClass="review-field-label" text="Document type" />
                                 <ChoiceBox fx:id="reviewTypeChoice" maxWidth="1.7976931348623157E308" />
                                 <Label styleClass="review-field-label" text="Invoice / credit reference" />
                                 <TextField fx:id="reviewReferenceField" promptText="Reference" />
                                 <Label styleClass="review-field-label" text="Document date" />
                                 <DatePicker fx:id="reviewDateField" maxWidth="1.7976931348623157E308" />
                                 <Label fx:id="reviewDueDateLabel" styleClass="review-field-label" text="Due date" />
                                 <DatePicker fx:id="reviewDueDateField" maxWidth="1.7976931348623157E308" />
                                 <Label fx:id="reviewDueDateHintLabel" managed="false" styleClass="review-estimated-hint" text="Due date was estimated 30 days from the invoice date." visible="false" wrapText="true" />
                                 <Label fx:id="reviewAmountTitleLabel" styleClass="review-field-label" text="Amount ($)" />
                                 <TextField fx:id="reviewAmountField" promptText="0.00" />
                                 <HBox alignment="CENTER" spacing="28.0" styleClass="review-reconciliation-summary">
                                    <VBox alignment="CENTER" spacing="3.0">
                                       <Label fx:id="reviewExpectedAmountTitleLabel" styleClass="review-reconciliation-label" text="Expected amount" />
                                       <Label fx:id="reviewExpectedAmountLabel" styleClass="review-reconciliation-value" text="N/A" />
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="3.0">
                                       <Label styleClass="review-reconciliation-label" text="Variance" />
                                       <Label fx:id="reviewVarianceLabel" styleClass="review-reconciliation-value" text="N/A" />
                                    </VBox>
                                 </HBox>
                                 <Button fx:id="refreshInvoiceAmountButton" managed="false" maxWidth="1.7976931348623157E308" onAction="#refreshInvoiceAmount" styleClass="secondary-scan-button, amount-refresh-button" text="Refresh Z-Office amount" visible="false">
                                    <graphic>
                                       <StackPane minHeight="18.0" minWidth="18.0" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0">
                                          <SVGPath fx:id="amountRefreshIcon" content="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z" styleClass="amount-refresh-icon" />
                                          <ProgressIndicator fx:id="amountRefreshProgress" managed="false" maxHeight="18.0" maxWidth="18.0" prefHeight="18.0" prefWidth="18.0" progress="-1.0" visible="false" />
                                       </StackPane>
                                    </graphic>
                                    <tooltip><Tooltip text="Look up the current invoice reference in Z-Office and update the expected amount. Your form edits are kept." /></tooltip>
                                 </Button>
                                 <Label fx:id="invoiceAmountRefreshMessageLabel" managed="false" styleClass="amount-refresh-message" visible="false" wrapText="true" />
                                 <Label styleClass="review-field-label" text="Notes" />
                                 <TextArea fx:id="reviewNotesField" prefRowCount="3" wrapText="true" />
                              </VBox>
                           </content>
                        </ScrollPane>
                     </center>
                     <bottom>
                        <VBox spacing="8.0">
                           <HBox spacing="8.0">
                              <Button fx:id="reviewBackButton" maxWidth="1.7976931348623157E308" onAction="#backToResults" styleClass="secondary-scan-button" text="Back to scanned list" HBox.hgrow="ALWAYS" />
                              <Button fx:id="reviewAcceptButton" maxWidth="1.7976931348623157E308" onAction="#acceptReview" styleClass="primary-scan-button" text="Accept" HBox.hgrow="ALWAYS" />
                           </HBox>
                        </VBox>
                     </bottom>
                  </BorderPane>
               </right>
            </BorderPane>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="22.0" left="24.0" right="24.0" top="22.0" />
   </padding>
   <stylesheets>
      <URL value="@../CSS/application.css" />
      <URL value="@../CSS/AiInvoiceScan.css" />
   </stylesheets>
</VBox>
