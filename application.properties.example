# Copy this file to src/main/resources/application.properties for local runs.
# Do not commit the resulting file: it can contain credentials and is ignored.
api.base.url=http://localhost:8080
api.token=alpha-local-development
# Prevent an unavailable or stalled API from leaving a screen busy indefinitely.
api.connect.timeout.seconds=10
api.read.timeout.seconds=60
# When enabled, invoice reconciliation/till metrics come live through Alpha API,
# and Z-only credits are added to the credit list as read-only rows.
z.live.enabled=false
VERSION=local
