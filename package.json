{
    "bin": {"Alpha-Income": "jdeploy-bundle/jdeploy.js"},
    "author": "Rainbow Health Pharmacy",
    "description": "An all in one solution for managing pharmacy income",
    "main": "index.js",
    "preferGlobal": true,
    "repository": "",
    "version": "1.1.11",
    "jdeploy": {
        "jdk": false,
        "args": [
            "-Xms256m",
            "-Xmx1024m",
            "-Dprism.order=es2,d3d,sw",
            "-Dprism.lcdtext=false"
        ],
        "javaVersion": "22",
        "winAppDir": "AppData\\Local\\Programs",
        "jar": "target/jpackage-input/Alpha-Income.jar",
        "javafx": true,
        "title": "Alpha Income"
    },
    "dependencies": {
        "command-exists-promise": "^2.0.2",
        "node-fetch": "2.6.7",
        "tar": "^4.4.8",
        "yauzl": "^2.10.0",
        "shelljs": "^0.8.4"
    },
    "license": "ISC",
    "name": "Alpha-Income",
    "files": ["jdeploy-bundle"],
    "scripts": {
        "test": "echo \"The JavaFX client has no automated test runner; use npm run web:test for the web migration.\"",
        "web:dev": "npm --prefix web run dev",
        "web:build": "npm --prefix web run build",
        "web:test": "npm --prefix web test",
        "web:test:e2e": "npm --prefix web run test:e2e"
    }
}
