{
    "bin": {"Alpha-Income": "jdeploy-bundle/jdeploy.js"},
    "author": "Rainbow Health Pharmacy",
    "description": "An all in one solution for managing pharmacy income",
    "main": "index.js",
    "preferGlobal": true,
    "repository": "",
    "version": "1.1.11",
    "jdeploy": {
        "jdk": false,
        "args": [
            "-Xms64m",
            "-Xmx1024m",
            "-D[win]prism.order=d3d,sw",
            "-D[linux]prism.order=es2,sw",
            "-Dalpha.performance.mode=quality",
            "-Dalpha.window.transparent=true"
        ],
        "javaVersion": "26",
        "winAppDir": "AppData\\Local\\Programs",
        "jar": "target/jpackage-input/Alpha-Income.jar",
        "javafx": true,
        "title": "Alpha Income"
    },
    "dependencies": {
        "node-fetch": "2.7.0",
        "tar": "^7.5.22",
        "yauzl": "^3.4.0",
        "shelljs": "^0.10.0"
    },
    "license": "ISC",
    "name": "Alpha-Income",
    "files": ["jdeploy-bundle"],
    "scripts": {"test": "echo \"Error: no test specified\" && exit 1"}
}
